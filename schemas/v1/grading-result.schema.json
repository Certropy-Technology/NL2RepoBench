{
  "$defs": {
    "FailureClass": {
      "enum": [
        "source",
        "spec",
        "environment",
        "verifier",
        "model",
        "infrastructure"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "LeafCase": {
      "additionalProperties": false,
      "description": "One verifier-owned test leaf after framework normalization.",
      "properties": {
        "details": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "duration_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "leaf_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Leaf Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "todo",
            "xfail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "leaf_id",
        "status"
      ],
      "title": "LeafCase",
      "type": "object",
      "x-nl2repobench-model": "LeafCase",
      "x-nl2repobench-runtime-validation": true
    },
    "LeafCollectionError": {
      "additionalProperties": false,
      "description": "A trusted runner error that prevents a valid score.",
      "properties": {
        "leaf_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leaf Id"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "LeafCollectionError",
      "type": "object",
      "x-nl2repobench-model": "LeafCollectionError",
      "x-nl2repobench-runtime-validation": true
    },
    "LeafCounts": {
      "additionalProperties": false,
      "description": "Counts derived from individual canonical leaves, never aggregates.",
      "properties": {
        "collected": {
          "minimum": 0,
          "title": "Collected",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "todo": {
          "default": 0,
          "minimum": 0,
          "title": "Todo",
          "type": "integer"
        },
        "xfail": {
          "default": 0,
          "minimum": 0,
          "title": "Xfail",
          "type": "integer"
        }
      },
      "required": [
        "collected"
      ],
      "title": "LeafCounts",
      "type": "object",
      "x-nl2repobench-model": "LeafCounts",
      "x-nl2repobench-runtime-validation": true
    },
    "LeafReport": {
      "additionalProperties": false,
      "description": "Runtime-neutral report consumed by the sole fixed-denominator evaluator.",
      "properties": {
        "collected": {
          "minimum": 0,
          "title": "Collected",
          "type": "integer"
        },
        "collection_errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LeafCollectionError"
          },
          "title": "Collection Errors",
          "type": "array"
        },
        "framework": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "frozen_total": {
          "exclusiveMinimum": 0,
          "title": "Frozen Total",
          "type": "integer"
        },
        "leaves": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LeafCase"
          },
          "title": "Leaves",
          "type": "array"
        },
        "report_format": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Report Format",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trusted_runner_exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trusted Runner Exit Code"
        }
      },
      "required": [
        "framework",
        "report_format",
        "collected",
        "frozen_total"
      ],
      "title": "LeafReport",
      "type": "object",
      "x-nl2repobench-model": "LeafReport",
      "x-nl2repobench-runtime-validation": true
    },
    "VerificationReason": {
      "enum": [
        "artifact-copy-failed",
        "candidate-workspace-rejected",
        "candidate-installation-failed",
        "candidate-call-failed",
        "setup-command-failed",
        "report-missing",
        "report-malformed",
        "duplicate-leaf-id",
        "collection-error",
        "collection-mismatch",
        "report-count-mismatch",
        "runner-abnormal-exit",
        "report-exit-mismatch",
        "verifier-timeout",
        "verifier-network-available",
        "verifier-internal-error",
        "integrity-failure"
      ],
      "title": "VerificationReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical reward and classification emitted by the evaluator.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/LeafCounts"
    },
    "details": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Details",
      "type": "array"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "frozen_total": {
      "exclusiveMinimum": 0,
      "title": "Frozen Total",
      "type": "integer"
    },
    "metric_contract": {
      "title": "Metric Contract",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/LeafReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reward": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Reward",
      "type": "number"
    },
    "runner_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runner Exit Code"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    }
  },
  "required": [
    "metric_contract",
    "valid",
    "reward",
    "frozen_total",
    "counts"
  ],
  "title": "EvaluationResult",
  "type": "object",
  "x-nl2repobench-model": "EvaluationResult",
  "x-nl2repobench-runtime-validation": true
}
