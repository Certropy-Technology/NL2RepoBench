{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility",
          "default": "public"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object",
      "x-nl2repobench-model": "ArtifactRef",
      "x-nl2repobench-runtime-validation": true
    },
    "DependencyBundle": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "inventory": {
                "type": "null"
              },
              "lock": {
                "type": "null"
              },
              "offline_store": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "package_manager": {
                "not": {
                  "const": "none"
                }
              },
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "inventory": {
                "allOf": [
                  {
                    "not": {
                      "type": "null"
                    }
                  },
                  {
                    "properties": {
                      "visibility": {
                        "const": "private"
                      }
                    }
                  }
                ]
              },
              "lock": {
                "allOf": [
                  {
                    "not": {
                      "type": "null"
                    }
                  },
                  {
                    "properties": {
                      "visibility": {
                        "const": "private"
                      }
                    }
                  }
                ]
              },
              "offline_store": {
                "allOf": [
                  {
                    "not": {
                      "type": "null"
                    }
                  },
                  {
                    "properties": {
                      "visibility": {
                        "const": "private"
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "lock",
              "offline_store",
              "inventory"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "package_manager": {
                "const": "none"
              },
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status",
              "package_manager"
            ]
          },
          "then": {
            "properties": {
              "packages": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "inventory": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offline_store": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "package_manager": {
          "$ref": "#/$defs/PackageManager"
        },
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Packages",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "package_manager"
      ],
      "title": "DependencyBundle",
      "type": "object",
      "x-nl2repobench-model": "DependencyBundle",
      "x-nl2repobench-runtime-validation": true
    },
    "EnvironmentLock": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "base_image": {
                "minLength": 1,
                "type": "string"
              },
              "base_image_digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "network_policy": {
                "not": {
                  "type": "null"
                }
              },
              "os_name": {
                "minLength": 1,
                "type": "string"
              },
              "runtime": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "runtime",
              "os_name",
              "base_image",
              "base_image_digest",
              "network_policy"
            ]
          }
        }
      ],
      "properties": {
        "base_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Image"
        },
        "base_image_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Image Digest"
        },
        "build_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Command"
        },
        "network_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "os_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os Name"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "system_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "System Packages",
          "type": "array"
        }
      },
      "title": "EnvironmentLock",
      "type": "object",
      "x-nl2repobench-model": "EnvironmentLock",
      "x-nl2repobench-runtime-validation": true
    },
    "HarborExecutionProfile": {
      "additionalProperties": false,
      "properties": {
        "agent_allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Agent Allowed Hosts",
          "type": "array"
        },
        "agent_network_mode": {
          "default": "public",
          "enum": [
            "public",
            "no-network",
            "allowlist"
          ],
          "title": "Agent Network Mode",
          "type": "string"
        },
        "agent_timeout_sec": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Agent Timeout Sec",
          "type": "number"
        },
        "candidate_install_timeout_sec": {
          "default": 90.0,
          "exclusiveMinimum": 0,
          "title": "Candidate Install Timeout Sec",
          "type": "number"
        },
        "candidate_total_timeout_sec": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "title": "Candidate Total Timeout Sec",
          "type": "number"
        },
        "cpus": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Cpus",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 3,
          "title": "Keywords",
          "type": "array"
        },
        "memory_mb": {
          "default": 2048,
          "minimum": 512,
          "title": "Memory Mb",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_mb": {
          "default": 4096,
          "minimum": 1024,
          "title": "Storage Mb",
          "type": "integer"
        },
        "verifier_network_mode": {
          "const": "no-network",
          "default": "no-network",
          "title": "Verifier Network Mode",
          "type": "string"
        },
        "verifier_timeout_sec": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Verifier Timeout Sec",
          "type": "number"
        },
        "workspace_artifact": {
          "default": "/workspace",
          "title": "Workspace Artifact",
          "type": "string"
        }
      },
      "required": [
        "description",
        "keywords"
      ],
      "title": "HarborExecutionProfile",
      "type": "object",
      "x-nl2repobench-model": "HarborExecutionProfile",
      "x-nl2repobench-runtime-validation": true
    },
    "MetricContract": {
      "additionalProperties": false,
      "description": "The only active fixed-denominator score contract.",
      "properties": {
        "collection_mismatch": {
          "default": "fail",
          "enum": [
            "fail",
            "record-only"
          ],
          "title": "Collection Mismatch",
          "type": "string"
        },
        "contract_id": {
          "const": "fixed-test-pass-rate-v1",
          "default": "fixed-test-pass-rate-v1",
          "title": "Contract Id",
          "type": "string"
        },
        "denominator_statuses": {
          "default": [
            "passed",
            "failed",
            "error",
            "skipped",
            "todo",
            "xfail"
          ],
          "items": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "todo",
              "xfail"
            ],
            "type": "string"
          },
          "title": "Denominator Statuses",
          "type": "array"
        },
        "formula": {
          "const": "clamp(passed / frozen_total, 0, 1)",
          "default": "clamp(passed / frozen_total, 0, 1)",
          "title": "Formula",
          "type": "string"
        },
        "passed_statuses": {
          "default": [
            "passed"
          ],
          "items": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "todo",
              "xfail"
            ],
            "type": "string"
          },
          "title": "Passed Statuses",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "MetricContract",
      "type": "object",
      "x-nl2repobench-model": "MetricContract",
      "x-nl2repobench-runtime-validation": true
    },
    "NetworkPolicy": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "allowed_hosts": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "allowlist"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "allowed_hosts": {
                "items": {
                  "enum": [
                    "api.anthropic.com",
                    "api.cohere.com",
                    "api.deepseek.com",
                    "api.fireworks.ai",
                    "api.groq.com",
                    "api.mistral.ai",
                    "api.openai.com",
                    "api.together.xyz",
                    "api.x.ai",
                    "ark.cn-beijing.volces.com",
                    "bedrock-runtime.us-east-1.amazonaws.com",
                    "crates.io",
                    "dashscope-intl.aliyuncs.com",
                    "dashscope.aliyuncs.com",
                    "files.pythonhosted.org",
                    "generativelanguage.googleapis.com",
                    "index.crates.io",
                    "openrouter.ai",
                    "proxy.golang.org",
                    "pypi.org",
                    "registry.npmjs.org",
                    "static.crates.io",
                    "sum.golang.org"
                  ]
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "allowed_hosts",
              "reason"
            ]
          }
        },
        {
          "properties": {
            "offline_dependencies": {
              "enum": [
                "preinstalled-image",
                "private-artifact",
                "missing"
              ]
            }
          }
        }
      ],
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "mode": {
          "default": "no-network",
          "enum": [
            "no-network",
            "allowlist"
          ],
          "title": "Mode",
          "type": "string"
        },
        "offline_dependencies": {
          "default": "missing",
          "enum": [
            "preinstalled-image",
            "private-artifact",
            "missing"
          ],
          "title": "Offline Dependencies",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference_source_fetch": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Reference Source Fetch",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "NetworkPolicy",
      "type": "object",
      "x-nl2repobench-model": "NetworkPolicy",
      "x-nl2repobench-runtime-validation": true
    },
    "PackageManager": {
      "enum": [
        "uv",
        "pip",
        "npm",
        "pnpm",
        "go-modules",
        "none"
      ],
      "title": "PackageManager",
      "type": "string"
    },
    "ProvenanceStatus": {
      "enum": [
        "known",
        "unknown"
      ],
      "title": "ProvenanceStatus",
      "type": "string"
    },
    "RuntimeLanguage": {
      "enum": [
        "python",
        "node",
        "go"
      ],
      "title": "RuntimeLanguage",
      "type": "string"
    },
    "RuntimeProfile": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "const": "python"
              }
            }
          },
          "then": {
            "properties": {
              "package_manager": {
                "enum": [
                  "uv",
                  "pip",
                  "none"
                ]
              },
              "runtime": {
                "const": "cpython"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "language": {
                "const": "node"
              }
            }
          },
          "then": {
            "properties": {
              "package_manager": {
                "enum": [
                  "npm",
                  "pnpm",
                  "none"
                ]
              },
              "runtime": {
                "const": "node"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "language": {
                "const": "go"
              }
            }
          },
          "then": {
            "properties": {
              "package_manager": {
                "enum": [
                  "go-modules"
                ]
              },
              "runtime": {
                "const": "go"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "package_manager_version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "package_manager_version"
            ]
          },
          "if": {
            "properties": {
              "package_manager": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "package_manager_version": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/RuntimeLanguage"
        },
        "package_manager": {
          "$ref": "#/$defs/PackageManager"
        },
        "package_manager_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Manager Version"
        },
        "runtime": {
          "enum": [
            "cpython",
            "node",
            "go"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "language",
        "runtime",
        "version",
        "package_manager"
      ],
      "title": "RuntimeProfile",
      "type": "object",
      "x-nl2repobench-model": "RuntimeProfile",
      "x-nl2repobench-runtime-validation": true
    },
    "SourceLock": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "upstream_url",
              "revision",
              "license_spdx",
              "source_digest"
            ]
          }
        }
      ],
      "properties": {
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Digest"
        },
        "status": {
          "$ref": "#/$defs/ProvenanceStatus",
          "default": "unknown"
        },
        "submodules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Submodules",
          "type": "array"
        },
        "upstream_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Url"
        }
      },
      "title": "SourceLock",
      "type": "object",
      "x-nl2repobench-model": "SourceLock",
      "x-nl2repobench-runtime-validation": true
    },
    "TaskLifecycleRecord": {
      "additionalProperties": false,
      "properties": {
        "approval_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Approval Refs",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus",
          "default": "discovered"
        }
      },
      "title": "TaskLifecycleRecord",
      "type": "object",
      "x-nl2repobench-model": "TaskLifecycleRecord",
      "x-nl2repobench-runtime-validation": true
    },
    "TaskMetadata": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "unknown",
          "title": "Category",
          "type": "string"
        },
        "difficulty": {
          "default": "unknown",
          "enum": [
            "easy",
            "medium",
            "hard",
            "unknown"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/RuntimeLanguage"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "language"
      ],
      "title": "TaskMetadata",
      "type": "object",
      "x-nl2repobench-model": "TaskMetadata",
      "x-nl2repobench-runtime-validation": true
    },
    "TaskStatus": {
      "enum": [
        "discovered",
        "frozen",
        "inventoried",
        "specified",
        "packaged",
        "oracle-passed",
        "controls-passed",
        "reviewed",
        "piloted",
        "published",
        "blocked",
        "excluded"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "TaskVerifierSpec": {
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "entrypoint": {
          "default": "run.py",
          "title": "Entrypoint",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
