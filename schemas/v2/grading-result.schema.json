{
  "$defs": {
    "FailureClass": {
      "enum": [
        "source",
        "spec",
        "environment",
        "verifier",
        "model",
        "infrastructure"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "NodeCollectionErrorV2": {
      "additionalProperties": false,
      "description": "A trusted runner collection failure that invalidates the result.",
      "properties": {
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Id"
        }
      },
      "required": [
        "message"
      ],
      "title": "NodeCollectionErrorV2",
      "type": "object",
      "x-nl2repobench-model": "NodeCollectionErrorV2",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeTestCaseV2": {
      "additionalProperties": false,
      "description": "One frozen leaf test result; aggregate reporter fields are ignored.",
      "properties": {
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "duration_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "todo"
          ],
          "title": "Status",
          "type": "string"
        },
        "test_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "status"
      ],
      "title": "NodeTestCaseV2",
      "type": "object",
      "x-nl2repobench-model": "NodeTestCaseV2",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeTestCountsV2": {
      "additionalProperties": false,
      "description": "Counts derived solely from individual leaf cases.",
      "properties": {
        "collected": {
          "default": 0,
          "minimum": 0,
          "title": "Collected",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "todo": {
          "default": 0,
          "minimum": 0,
          "title": "Todo",
          "type": "integer"
        }
      },
      "title": "NodeTestCountsV2",
      "type": "object",
      "x-nl2repobench-model": "NodeTestCountsV2",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeTestReportV2": {
      "additionalProperties": false,
      "description": "Verifier-owned JSON report for a ``node:test`` run.",
      "properties": {
        "collected": {
          "minimum": 0,
          "title": "Collected",
          "type": "integer"
        },
        "collection_errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NodeCollectionErrorV2"
          },
          "title": "Collection Errors",
          "type": "array"
        },
        "framework": {
          "const": "node:test",
          "default": "node:test",
          "title": "Framework",
          "type": "string"
        },
        "report_format": {
          "const": "node-test-json-v1",
          "default": "node-test-json-v1",
          "title": "Report Format",
          "type": "string"
        },
        "runner_exit_code": {
          "title": "Runner Exit Code",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tests": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NodeTestCaseV2"
          },
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "collected",
        "runner_exit_code"
      ],
      "title": "NodeTestReportV2",
      "type": "object",
      "x-nl2repobench-model": "NodeTestReportV2",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeVerificationReason": {
      "description": "Legacy Node reason enum retained for v2 report compatibility.",
      "enum": [
        "node-report-missing",
        "node-report-malformed",
        "node-duplicate-test-id",
        "node-collection-error",
        "node-collection-mismatch",
        "node-report-count-mismatch",
        "node-runner-abnormal-exit",
        "node-report-exit-mismatch",
        "candidate-workspace-rejected",
        "candidate-installation-failed",
        "candidate-call-failed",
        "verifier-network-available",
        "verifier-internal-error",
        "integrity-failure",
        "node-report-missing",
        "node-report-malformed",
        "node-duplicate-test-id",
        "node-collection-error",
        "node-collection-mismatch",
        "node-report-count-mismatch",
        "node-runner-abnormal-exit",
        "node-report-exit-mismatch"
      ],
      "title": "NodeVerificationReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical reward and verifier classification for a Node run.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/NodeTestCountsV2"
    },
    "details": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Details",
      "type": "array"
    },
    "expected_total": {
      "exclusiveMinimum": 0,
      "title": "Expected Total",
      "type": "integer"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeVerificationReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_contract": {
      "default": "node-test-leaf-pass-rate-v1",
      "title": "Metric Contract",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeTestReportV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reward": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Reward",
      "type": "number"
    },
    "runner_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runner Exit Code"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    }
  },
  "required": [
    "valid",
    "reward",
    "expected_total",
    "counts"
  ],
  "title": "NodeGradingResultV2",
  "type": "object",
  "x-nl2repobench-model": "NodeGradingResultV2",
  "x-nl2repobench-runtime-validation": true
}
