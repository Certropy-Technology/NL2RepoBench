{
  "$defs": {
    "AgentRuntimeImageLock": {
      "additionalProperties": false,
      "description": "Prebuilt OpenHands runtime shared by every Agent environment.",
      "properties": {
        "fork_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Fork Commit",
          "type": "string"
        },
        "image": {
          "pattern": "^[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9._-]+$",
          "title": "Image",
          "type": "string"
        },
        "image_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "litellm_version": {
          "title": "Litellm Version",
          "type": "string"
        },
        "python_executable": {
          "const": "/opt/openhands-sdk-venv/bin/python",
          "default": "/opt/openhands-sdk-venv/bin/python",
          "title": "Python Executable",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sdk_version": {
          "title": "Sdk Version",
          "type": "string"
        },
        "tools_version": {
          "title": "Tools Version",
          "type": "string"
        }
      },
      "required": [
        "image",
        "image_id",
        "fork_commit",
        "sdk_version",
        "tools_version",
        "litellm_version"
      ],
      "title": "AgentRuntimeImageLock",
      "type": "object",
      "x-nl2repobench-model": "AgentRuntimeImageLock",
      "x-nl2repobench-runtime-validation": true
    },
    "HarborVersionLock": {
      "additionalProperties": false,
      "properties": {
        "lock_file": {
          "title": "Lock File",
          "type": "string"
        },
        "lock_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lock Sha256",
          "type": "string"
        },
        "runner": {
          "title": "Runner",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_schema": {
          "title": "Task Schema",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "task_schema",
        "runner",
        "lock_file",
        "lock_sha256"
      ],
      "title": "HarborVersionLock",
      "type": "object",
      "x-nl2repobench-model": "HarborVersionLock",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeImageLockV2": {
      "additionalProperties": false,
      "properties": {
        "agent_base": {
          "title": "Agent Base",
          "type": "string"
        },
        "platform": {
          "const": "linux/amd64",
          "default": "linux/amd64",
          "title": "Platform",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "development-only",
          "enum": [
            "locked",
            "development-only"
          ],
          "title": "Status",
          "type": "string"
        },
        "verifier_base": {
          "title": "Verifier Base",
          "type": "string"
        },
        "verifier_python_base": {
          "default": "python@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a",
          "title": "Verifier Python Base",
          "type": "string"
        }
      },
      "required": [
        "agent_base",
        "verifier_base"
      ],
      "title": "NodeImageLockV2",
      "type": "object",
      "x-nl2repobench-model": "NodeImageLockV2",
      "x-nl2repobench-runtime-validation": true
    },
    "NodeRuntimeLockV2": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "default": "/usr/local/bin/node",
          "title": "Executable",
          "type": "string"
        },
        "libc": {
          "enum": [
            "glibc",
            "musl"
          ],
          "title": "Libc",
          "type": "string"
        },
        "npm_executable": {
          "default": "/usr/local/bin/npm",
          "title": "Npm Executable",
          "type": "string"
        },
        "npm_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Npm Version",
          "type": "string"
        },
        "pnpm_version": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pnpm Version"
        },
        "runtime_version": {
          "pattern": "^(?:22|24)\\.[0-9]+\\.[0-9]+$",
          "title": "Runtime Version",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "runtime_version",
        "npm_version",
        "libc"
      ],
      "title": "NodeRuntimeLockV2",
      "type": "object",
      "x-nl2repobench-model": "NodeRuntimeLockV2",
      "x-nl2repobench-runtime-validation": true
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_runtime": {
      "$ref": "#/$defs/AgentRuntimeImageLock"
    },
    "harbor": {
      "$ref": "#/$defs/HarborVersionLock"
    },
    "images": {
      "$ref": "#/$defs/NodeImageLockV2"
    },
    "node_grader": {
      "default": "absent",
      "enum": [
        "absent",
        "locked"
      ],
      "title": "Node Grader",
      "type": "string"
    },
    "node_report_schema": {
      "const": "node-test-json-v1",
      "default": "node-test-json-v1",
      "title": "Node Report Schema",
      "type": "string"
    },
    "node_runtime_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Runtime Sha256"
    },
    "runtime": {
      "$ref": "#/$defs/NodeRuntimeLockV2"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "development-only",
      "enum": [
        "locked",
        "development-only"
      ],
      "title": "Status",
      "type": "string"
    },
    "verifier_requirements_lock": {
      "default": "verifier/requirements.lock.txt",
      "title": "Verifier Requirements Lock",
      "type": "string"
    },
    "verifier_requirements_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verifier Requirements Sha256"
    }
  },
  "required": [
    "harbor",
    "images",
    "agent_runtime",
    "runtime"
  ],
  "title": "NodeHarborToolchainLockV2",
  "type": "object",
  "x-nl2repobench-model": "NodeHarborToolchainLockV2",
  "x-nl2repobench-runtime-validation": true
}
