# NOTE: tests.framework has no custom-adapter value in the shared schema, so it
# stays at the schema default. The authoritative runner descriptor for this task
# is verifier.protocol = "custom-json-v1" with entrypoint test.sh.
[tests]
expected_total = 32
expected_total_source = "frozen-collection"
commands = ["python /tests/verifier/run.py"]
protected_paths = ["tests", "system_tests"]

[metric]
contract_id = "fixed-test-pass-rate-v1"
passed_statuses = ["passed"]
excluded_statuses = ["skipped"]
collection_mismatch = "fail"
formula = "clamp(passed / frozen_total, 0, 1)"

[verifier]
protocol = "custom-json-v1"
bundle = { digest = "sha256:c71b812322e3a1730f4c9fe21aeba0e067e19b4e0bd7ada50b4c263b4cdbf5cf", size_bytes = 40960, media_type = "application/vnd.nl2repobench.private-bundle+tar", uri = "artifact://private/sha256:c71b812322e3a1730f4c9fe21aeba0e067e19b4e0bd7ada50b4c263b4cdbf5cf", visibility = "private" }
entrypoint = "run.py"

[harbor]
description = "Build the deterministic core of the google-auth credential and token library from an empty workspace."
keywords = ["python", "oauth2", "jwt", "credentials", "cryptography", "separate-verifier"]
agent_timeout_sec = 3600.0
verifier_timeout_sec = 600.0
candidate_install_timeout_sec = 120.0
candidate_total_timeout_sec = 300.0
agent_network_mode = "no-network"
verifier_network_mode = "no-network"
cpus = 2
memory_mb = 4096
storage_mb = 8192
workspace_artifact = "/workspace"

[lifecycle]
status = "controls-passed"
reason = "Source/license frozen and reverified, offline hash-locked wheelhouse closure built into digest-pinned agent and verifier images, no-network baseline enforced, Oracle reward 1.0 at 32/32 collection, and the empty/stub/forgery/symlink/install-timeout/adapter-timeout/offline control matrix all behaved correctly. Worker endpoint is awaiting-agent-run; the shared lifecycle enum has no such value. This lane did not start a Harbor model Agent Run."

[oracle_bundle]
digest = "sha256:a3cad5e6ecdb8a3cfa8da71d075db0c201a95220b2f8541eed8a068f13a1e1a2"
