{
  "schema_version": "1.0",
  "task_id": "urllib3",
  "revision": "85a8a9cfad3398bc504d088233d0a11af219a82a",
  "contract_to_public_behavior": {
    "exports-and-version": ["urllib3.__version__", "urllib3.__all__"],
    "url-http": ["urllib3.util.url.parse_url", "urllib3.util.url.Url"],
    "url-auth-port": ["parse_url auth and port fields"],
    "url-ipv6": ["parse_url IPv6 host handling"],
    "url-query-fragment": ["Url.url reconstruction"],
    "url-invalid-port": ["urllib3.exceptions.LocationParseError"],
    "headers-case-insensitive": ["HTTPHeaderDict mapping semantics"],
    "headers-repeat-order": ["HTTPHeaderDict.add", "HTTPHeaderDict.getlist"],
    "headers-combine": ["HTTPHeaderDict.add(combine=True)"],
    "headers-copy": ["HTTPHeaderDict.copy"],
    "make-headers": ["urllib3.util.request.make_headers"],
    "basic-auth": ["make_headers basic_auth"],
    "content-type-guess": ["urllib3.fields.guess_content_type"],
    "request-field": ["urllib3.fields.RequestField"],
    "multipart-fixed-boundary": ["urllib3.filepost.encode_multipart_formdata"],
    "timeout-from-float": ["urllib3.util.timeout.Timeout.from_float"],
    "timeout-clone": ["Timeout.clone"],
    "timeout-invalid": ["Timeout validation errors"],
    "retry-from-int": ["urllib3.util.retry.Retry.from_int"],
    "retry-is-retry": ["Retry.is_retry"],
    "retry-backoff": ["Retry.get_backoff_time"],
    "retry-history": ["Retry.increment and RequestHistory"],
    "retry-exhausted": ["MaxRetryError behavior"],
    "response-read": ["HTTPResponse.read"],
    "response-stream": ["HTTPResponse.stream"],
    "response-headers": ["HTTPResponse.getheaders/getheader"],
    "response-json": ["HTTPResponse.json"],
    "response-decode-disabled": ["HTTPResponse decode_content=False"],
    "exceptions-inheritance": ["urllib3.exceptions exception hierarchy"],
    "root-exports": ["urllib3.__all__"],
    "deterministic-repetition": ["URL/header/multipart repeatability"],
    "no-network-contract": ["no socket calls in scored adapter"]
  },
  "public_behavior_to_tests": {
    "urllib3.util.url": ["url-http", "url-auth-port", "url-ipv6", "url-query-fragment", "url-invalid-port"],
    "urllib3._collections": ["headers-case-insensitive", "headers-repeat-order", "headers-combine", "headers-copy"],
    "urllib3.util.request": ["make-headers", "basic-auth"],
    "urllib3.fields": ["content-type-guess", "request-field"],
    "urllib3.filepost": ["multipart-fixed-boundary"],
    "urllib3.util.timeout": ["timeout-from-float", "timeout-clone", "timeout-invalid"],
    "urllib3.util.retry": ["retry-from-int", "retry-is-retry", "retry-backoff", "retry-history", "retry-exhausted"],
    "urllib3.response": ["response-read", "response-stream", "response-headers", "response-json", "response-decode-disabled"],
    "urllib3.exceptions": ["url-invalid-port", "exceptions-inheritance", "retry-exhausted"],
    "urllib3.__init__": ["exports-and-version", "root-exports", "deterministic-repetition"]
  }
}
