  "commonjs_selected_fs_compatibility": [
    "access",
    "appendFile",
    "chmod",
    "close",
    "copyFile",
    "cp",
    "createReadStream",
    "createWriteStream",
    "lstat",
    "mkdir",
    "open",
    "read",
    "readFile",
    "readdir",
    "realpath",
    "rename",
    "rm",
    "stat",
    "unlink",
    "write",
    "writeFile",
    "writev",
    "constants",
    "promises"
  ],
  "explicit_exclusions": [
    "complete behavioral parity for every Node fs export",
    "cross-device fixture execution",
    "Windows junction and case-only rename behavior",
    "character devices, block devices, FIFOs, and sockets",
    "watchers and streams beyond export compatibility",
    "native addons and platform-specific filesystem extensions"
