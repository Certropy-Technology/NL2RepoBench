  "alias_families": {
    "ensureDir": ["mkdirs", "mkdirp"],
    "ensureFile": ["createFile"],
    "ensureLink": ["createLink"],
    "ensureSymlink": ["createSymlink"],
    "emptyDir": ["emptydir"],
    "Json": ["JSON"]
