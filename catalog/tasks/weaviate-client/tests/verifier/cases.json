      "operation": "auth",
      "kind": "client-credentials",
      "secret": "secret"
    },
    "expected": {
      "value": {
        "fields": {
          "client_secret": "secret",
          "scope": null
        },
        "type": "_ClientCredentials"
      },
      "warnings": []
    }
  },
  {
