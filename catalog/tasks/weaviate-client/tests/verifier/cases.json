  {
    "id": "protocol-basic",
    "request": {
      "operation": "connection",
      "kind": "protocol",
      "params": {
        "host": "localhost",
        "port": 8080,
        "secure": false
      }
    },
    "expected": {
      "is_gcp": false,
      "model": {
        "fields": {
          "host": "localhost",
          "port": 8080,
          "secure": false
        },
        "type": "ProtocolParams"
      }
    }
  },
  {
    "id": "protocol-gcp",
    "request": {
      "operation": "connection",
      "kind": "protocol",
      "params": {
        "host": "cluster.gcp.weaviate.cloud",
        "port": 443,
        "secure": true
      }
    },
    "expected": {
      "is_gcp": true,
      "model": {
        "fields": {
          "host": "cluster.gcp.weaviate.cloud",
          "port": 443,
          "secure": true
        },
        "type": "ProtocolParams"
      }
    }
  },
  {
    "id": "protocol-empty-host",
    "request": {
      "operation": "connection",
      "kind": "protocol",
      "params": {
        "host": "",
        "port": 8080,
        "secure": false
      }
    },
    "expected": {
      "error": "ValidationError",
      "message": "1 validation error for ProtocolParams\nhost\n  Value error, host must not be empty [type=value_error, input_value='', input_type=str]\n    For further information visit https://errors.pydantic.dev/2.13/v/value_error"
    }
  },
  {
    "id": "protocol-invalid-port",
    "request": {
      "operation": "connection",
      "kind": "protocol",
      "params": {
        "host": "localhost",
        "port": 70000,
        "secure": false
      }
    },
    "expected": {
      "error": "ValidationError",
      "message": "1 validation error for ProtocolParams\nport\n  Value error, port must be between 0 and 65535 [type=value_error, input_value=70000, input_type=int]\n    For further information visit https://errors.pydantic.dev/2.13/v/value_error"
    }
  },
  {
    "id": "connection-http-default",
    "request": {
      "operation": "connection",
      "kind": "from-url",
      "url": "http://localhost",
      "grpc_port": 50051
    },
    "expected": {
      "gcp_on_wcd": false,
      "grpc_target": "localhost:50051",
      "http_url": "http://localhost:80",
      "model": {
        "fields": {
          "grpc": {
            "host": "localhost",
            "port": 50051,
            "secure": false
          },
          "http": {
            "host": "localhost",
            "port": 80,
            "secure": false
          }
        },
        "type": "ConnectionParams"
      }
    }
  },
  {
    "id": "connection-https-default",
    "request": {
      "operation": "connection",
      "kind": "from-url",
      "url": "https://demo.weaviate.cloud",
      "grpc_port": 443
    },
    "expected": {
      "error": "ValidationError",
      "message": "1 validation error for ConnectionParams\n  Value error, http.port and grpc.port must be different if using the same host [type=value_error, input_value={'http': ProtocolParams(h... port=443, secure=True)}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/value_error"
    }
  },
  {
    "id": "connection-explicit",
    "request": {
      "operation": "connection",
      "kind": "from-url",
      "url": "https://example.com:8443",
      "grpc_port": 50052,
      "grpc_secure": false
    },
    "expected": {
      "gcp_on_wcd": false,
      "grpc_target": "example.com:50052",
      "http_url": "https://example.com:8443",
      "model": {
        "fields": {
          "grpc": {
            "host": "example.com",
            "port": 50052,
            "secure": true
          },
          "http": {
            "host": "example.com",
            "port": 8443,
            "secure": true
          }
        },
        "type": "ConnectionParams"
      }
    }
  },
  {
    "id": "connection-unsupported-scheme",
    "request": {
      "operation": "connection",
      "kind": "from-url",
      "url": "ftp://example.com",
      "grpc_port": 50051
    },
    "expected": {
      "error": "ValueError",
      "message": "Unsupported scheme: ftp"
    }
  },
  {
    "id": "connection-collision",
    "request": {
      "operation": "connection",
      "kind": "from-params",
      "params": {
        "http_host": "same",
        "http_port": 443,
        "http_secure": true,
        "grpc_host": "same",
        "grpc_port": 443,
        "grpc_secure": true
      }
    },
    "expected": {
      "error": "ValidationError",
      "message": "1 validation error for ConnectionParams\n  Value error, http.port and grpc.port must be different if using the same host [type=value_error, input_value={'http': ProtocolParams(h... port=443, secure=True)}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/value_error"
    }
  },
