      "expires_in": -1
    },
    "expected": {
      "value": {
        "fields": {
          "access_token": "access",
          "expires_in": -1,
          "refresh_token": "refresh"
        },
        "type": "_BearerToken"
      },
      "warnings": [
        {
          "category": "UserWarning",
          "message": "Auth003: Access token expiration time is negative: -1."
        }
      ]
    }
