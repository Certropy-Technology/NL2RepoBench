[Unit]
Description=NL2RepoBench SQLite authoring supervisor (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service
OnFailure=nl2repobench-authoring-failure-marker@%i.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/NL2RepoBench-integration-20260827
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/data/NL2RepoBench-integration-20260827/.nl2repo/authoring-live/tmp
EnvironmentFile=-/root/.config/itbench/bootstrap-secrets.env
EnvironmentFile=/etc/nl2repobench/authoring-scheduler-%i.env
ExecStart=/data/NL2RepoBench-integration-20260827/scripts/run_authoring_supervisor.sh --scheduler-db ${SCHEDULER_DB} --branch main --interval-sec 60
Restart=always
RestartSec=30
RestartPreventExitStatus=2 64 78
TimeoutStopSec=45
KillMode=process
LimitNOFILE=8192

# Phase 3 template only. Installation and enablement are cutover operations.
[Install]
WantedBy=multi-user.target
