[Unit]
Description=NL2RepoBench authoring auto-discovery coordinator
Wants=network-online.target docker.service
After=network-online.target docker.service nl2repobench-authoring-supervisor.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/NL2RepoBench-integration-20260827
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/data/NL2RepoBench-integration-20260827/.nl2repo/authoring-live/tmp
Environment=NL2REPO_AUTO_COORDINATOR=1
EnvironmentFile=-/root/.config/itbench/bootstrap-secrets.env
ExecStart=/data/NL2RepoBench-integration-20260827/.venv/bin/python3 /data/NL2RepoBench-integration-20260827/scripts/authoring_auto_coordinator.py --repository-root /data/NL2RepoBench-integration-20260827 --live-root .nl2repo/authoring-live --discovery-pool .nl2repo/authoring-live/supervisor/discovery-pool.json --discovery-seed-pool reports/authoring-discovery-pool.json --pool-refresher scripts/refresh_authoring_discovery_pool.py --pool-refresh-cooldown-seconds 21600 --pool-refresh-limit 250 --pool-max-per-language 500 --runner /data/pi-tmp/root/c1-runtime/run_authoring_loop.py --max-agents 24 --pending-threshold 20 --discovery-batch-size 8 --discovery-cooldown-seconds 900 --interval-seconds 60 --agent-timeout-seconds 14400 --lease-seconds 18000 --command-timeout-seconds 900 --docker-root /data/docker-runtime/docker --docker-min-free-bytes 21474836480 --docker-worker-reserve-bytes 2147483648 --fallback-provider aliyun-qwen-openai-responses --fallback-model qwen3.8-flash --fallback-thinking high
Restart=always
RestartSec=30
TimeoutStopSec=30
# Direct authoring loops own their own process groups and leases.  A
# coordinator restart must not terminate in-flight authoring work.
KillMode=process
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
