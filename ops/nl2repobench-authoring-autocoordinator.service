[Unit]
Description=NL2RepoBench authoring auto-discovery coordinator
Wants=network-online.target docker.service
After=network-online.target docker.service nl2repobench-authoring-supervisor.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/NL2RepoBench-integration-20260827
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/data/NL2RepoBench-integration-20260827/.nl2repo/authoring-live/tmp
Environment=NL2REPO_AUTO_COORDINATOR=1
EnvironmentFile=-/root/.config/itbench/bootstrap-secrets.env
ExecStart=/data/NL2RepoBench-integration-20260827/.venv/bin/python3 /data/NL2RepoBench-integration-20260827/scripts/authoring_auto_coordinator.py --repository-root /data/NL2RepoBench-integration-20260827 --live-root .nl2repo/authoring-live --discovery-pool reports/authoring-discovery-pool.json --runner /data/pi-tmp/root/c1-runtime/run_authoring_loop.py --max-agents 8 --pending-threshold 10 --discovery-batch-size 4 --discovery-cooldown-seconds 900 --interval-seconds 60 --agent-timeout-seconds 14400 --lease-seconds 18000 --command-timeout-seconds 900
Restart=always
RestartSec=30
TimeoutStopSec=30
# Direct authoring loops own their own process groups and leases.  A
# coordinator restart must not terminate in-flight authoring work.
KillMode=process
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
