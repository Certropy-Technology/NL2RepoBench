[Unit]
Description=NL2RepoBench authoring supervisor
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/NL2RepoBench-integration-20260827
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/data/NL2RepoBench-integration-20260827/.nl2repo/authoring-live/tmp
EnvironmentFile=-/root/.config/itbench/bootstrap-secrets.env
ExecStart=/data/NL2RepoBench-integration-20260827/scripts/run_authoring_supervisor.sh --branch main --interval-sec 60 --director-mode llm --director-interval-sec 600 --max-integrations 3 --max-total-controllers 6 --resume-stopped-controllers --runtime-config /data/NL2RepoBench-integration-20260827/.nl2repo/authoring-live/supervisor/runtime-config.json
Restart=always
RestartSec=30
TimeoutStopSec=45
# Controllers and the archive watcher have their own durable lifecycle.  Do
# not terminate in-flight authoring work when the supervisor itself restarts.
KillMode=process
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
